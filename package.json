{
  "name": "sourcewatch",
  "version": "2.0.0-alpha.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server.ts",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint src ui tests scripts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:audit": "tsx --test tests/audit-*.test.ts",
    "test:soak": "tsx scripts/soak.ts",
    "cli": "tsx scripts/sourcewatch-cli.ts",
    "test:workspace": "tsx --test --test-concurrency=2 tests/workspace*.test.ts tests/vault.test.ts tests/canvas*.test.ts tests/intelligence.test.ts",
    "benchmark:network": "tsx scripts/benchmark-network.ts",
    "benchmark:global-graph": "tsx scripts/benchmark-global-graph.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "diff": "^8.0.2",
    "fastify": "^5.6.0",
    "fflate": "^0.8.2",
    "ipaddr.js": "^2.2.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0"
  }
}
