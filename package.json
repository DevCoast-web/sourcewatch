{
  "name": "sourcewatch",
  "version": "2.0.0-beta.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server.ts",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint src ui tests scripts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:audit": "tsx --test tests/audit-*.test.ts",
    "test:soak": "tsx scripts/soak.ts",
    "cli": "tsx scripts/sourcewatch-cli.ts",
    "test:workspace": "tsx --test --test-concurrency=2 tests/workspace*.test.ts tests/vault.test.ts tests/canvas*.test.ts tests/intelligence.test.ts",
    "benchmark:network": "tsx scripts/benchmark-network.ts",
    "benchmark:global-graph": "tsx scripts/benchmark-global-graph.ts",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dir": "npm run build && npm run desktop:prepare && electron-builder --config desktop/builder.cjs --win dir --publish never",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --config desktop/builder.cjs --win nsis portable --publish never"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "diff": "^8.0.2",
    "fastify": "^5.6.0",
    "fflate": "^0.8.2",
    "ipaddr.js": "^2.2.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0"
  },
  "description": "Local-first website capture, evidence preservation and connected research workspace",
  "author": "SourceWatch contributors",
  "license": "MIT",
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
